{
  "name": "10up/meridian-theme",
  "type": "wordpress-theme",
  "version": "1.0.0",
  "authors": [
    {
      "name": "10up",
      "email": "info@10up.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "10up/wp-framework": "~1.3.1"
  },
  "require-dev": {
    "10up/phpcs-composer": "dev-trunk",
    "fakerphp/faker": "^1.24"
  },
  "scripts": {
    "lint": "phpcs .",
    "lint-fix": "phpcbf ."
  },
  "autoload": {
    "psr-4": {
      "MeridianTheme\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
