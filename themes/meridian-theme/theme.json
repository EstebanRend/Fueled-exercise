				},
				{
					"name": "Heading 3",
					"slug": "heading-3",
					"size": "1.75rem",
					"fluid": {
						"min": "1.5rem",
						"max": "1.75rem"
					}
				},
				{
					"name": "Heading 2",
					"slug": "heading-2",
					"size": "2.25rem",
					"fluid": {
