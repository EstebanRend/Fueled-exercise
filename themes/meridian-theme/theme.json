		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "6px"
				},
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem",
						"top": "0.75rem"
					}
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--ink)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--ink)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"letterSpacing": "-0.018em",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-1)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-3)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-4)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-dark)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--24)",
			"padding": {
				"bottom": "0",
				"left": "var(--wp--custom--site-outer-padding)",
				"right": "var(--wp--custom--site-outer-padding)",
				"top": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.6"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Site Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Site Footer"
		}
	],
	"version": 3,
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json"
}
